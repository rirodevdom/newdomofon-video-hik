[Unit]
Description=NewDomofon Video Hikvision Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=newdomofon-hik
Group=newdomofon-hik
WorkingDirectory=/opt/newdomofon-video-hik
EnvironmentFile=/etc/newdomofon-video-hik/app.env
ExecStart=/usr/bin/node /opt/newdomofon-video-hik/dist/index.js
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/newdomofon-video-hik

[Install]
WantedBy=multi-user.target
