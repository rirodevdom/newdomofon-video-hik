NODE_ENV=production
HIK_NODE_HOST=0.0.0.0
HIK_NODE_PORT=3020

# Manual pairing: deploy Hikvision-node first, then copy these exact values into
# Administration -> Nodes -> Create node on master. Master does not generate them.
DVR_MASTER_URL=REPLACE_WITH_MASTER_URL
DVR_NODE_ID=REPLACE_WITH_NODE_ID
DVR_NODE_TOKEN=REPLACE_WITH_NODE_TOKEN
DVR_NODE_MEDIA_SECRET=REPLACE_WITH_MEDIA_SECRET
DVR_NODE_PUBLIC_BASE_URL=REPLACE_WITH_PUBLIC_URL
DVR_NODE_INTERNAL_URL=REPLACE_WITH_INTERNAL_URL

# Local-only encryption key. Never enter this value on master.
HIK_NODE_STATE_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

HIK_NODE_ROOT=/var/lib/newdomofon-video-hik
HIK_NODE_STATE_FILE=/var/lib/newdomofon-video-hik/state.enc.json
HIK_NODE_LIVE_ROOT=/var/lib/newdomofon-video-hik/live
HIK_NODE_ARCHIVE_ROOT=/var/lib/newdomofon-video-hik/archive
HIK_NODE_TEMP_ROOT=/var/lib/newdomofon-video-hik/tmp

HIK_MASTER_REQUEST_TIMEOUT_MS=10000
HIK_MASTER_POLL_SECONDS=20
HIK_HEARTBEAT_SECONDS=20
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Preferred Hikvision transport. The workers are built locally from the official
# operator-supplied Linux64 Device Network SDK package. Persistent live + alarms
# are grouped into one hik-sdk-device-worker process per physical DVR.
HIK_SDK_WORKER=/opt/hikvision/hcnetsdk/bin/hik-sdk-worker
HIK_SDK_CHANNEL_PROBE=/opt/hikvision/hcnetsdk/bin/hik-sdk-channel-probe
HIK_SDK_DEVICE_WORKER=/opt/hikvision/hcnetsdk/bin/hik-sdk-device-worker
HIK_SDK_DEFAULT_PORT=8000
HIK_SDK_COMMAND_TIMEOUT_MS=20000
HIK_NATIVE_SDK_PREFERRED=true
# Set true only when every Hikvision device assigned to this node must use SDK.
HIK_NATIVE_SDK_REQUIRED=false
# Keep false to prevent an SDK error from silently reverting to RTSP/ISAPI.
HIK_NATIVE_SDK_FALLBACK=false

# Native event collection keeps realtime alarm callbacks and periodically
# reconciles recent event history from each DVR into the local SQLite event DB.
HIK_EVENT_SYNC_ENABLED=true
HIK_EVENT_SYNC_SECONDS=60
HIK_EVENT_SYNC_OVERLAP_SECONDS=120
HIK_EVENT_SYNC_INITIAL_LOOKBACK_SECONDS=3600

# Persistent historical backfill walks backwards from the realtime window and
# stores older DVR event metadata in the same SQLite database. Cursor and target
# are persisted per physical DVR, so service restarts continue from the last
# successful chunk rather than starting again.
HIK_EVENT_BACKFILL_ENABLED=true
HIK_EVENT_BACKFILL_RETENTION_DAYS=30
HIK_EVENT_BACKFILL_CHUNK_SECONDS=21600
HIK_EVENT_BACKFILL_INTERVAL_SECONDS=30

# Legacy compatibility settings are retained for installations without HCNetSDK.
HIK_ISAPI_TIMEOUT_MS=10000
HIK_CHANNEL_SYNC_SECONDS=300
HIK_STREAM_SETTINGS_CONCURRENCY=4
HIK_SEGMENT_SECONDS=4
HIK_LIVE_WINDOW=8
HIK_ARCHIVE_SEARCH_PAGE_SIZE=64
HIK_ARCHIVE_SEARCH_MAX_PAGES=80
HIK_DEVICE_ARCHIVE_MAX_SECONDS=3600
HIK_DEVICE_ARCHIVE_SESSION_SECONDS=300
HIK_DEVICE_ARCHIVE_SESSION_KEEP_MS=900000

# Scalable native archive pool. The default production target is 48 independent
# archive playbacks per physical DVR, sharded across 3 isolated archive workers.
# Viewers on an already active/cached time range can share existing media and do
# not necessarily consume another native playback slot.
HIK_DEVICE_ARCHIVE_MAX_ACTIVE_PER_DVR=48
HIK_DEVICE_ARCHIVE_WORKER_COUNT=3
HIK_DEVICE_ARCHIVE_MAX_ACTIVE_PER_WORKER=16
HIK_SMARTYARD_ARCHIVE_MAX_BURSTS_PER_DVR=48

HIK_MEDIA_TOKEN_MAX_SECONDS=3600
HIK_TRANSCODE_H265=true
HIK_RTSP_TRANSPORT=tcp
HIK_FFMPEG_LOGLEVEL=warning
