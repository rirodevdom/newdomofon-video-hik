NODE_ENV=production
HIK_NODE_HOST=0.0.0.0
HIK_NODE_PORT=3020

# Manual pairing: deploy Hikvision-node first, then copy these exact values into
# Administration -> Nodes -> Create node on master. Master does not generate them.
DVR_MASTER_URL=REPLACE_WITH_MASTER_URL
DVR_NODE_ID=REPLACE_WITH_NODE_ID
DVR_NODE_TOKEN=REPLACE_WITH_NODE_TOKEN
DVR_NODE_MEDIA_SECRET=REPLACE_WITH_MEDIA_SECRET
DVR_NODE_PUBLIC_BASE_URL=REPLACE_WITH_PUBLIC_URL
DVR_NODE_INTERNAL_URL=REPLACE_WITH_INTERNAL_URL

# Local-only encryption key. Never enter this value on master.
HIK_NODE_STATE_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

HIK_NODE_ROOT=/var/lib/newdomofon-video-hik
HIK_NODE_STATE_FILE=/var/lib/newdomofon-video-hik/state.enc.json
HIK_NODE_LIVE_ROOT=/var/lib/newdomofon-video-hik/live
HIK_NODE_ARCHIVE_ROOT=/var/lib/newdomofon-video-hik/archive
HIK_NODE_TEMP_ROOT=/var/lib/newdomofon-video-hik/tmp

HIK_MASTER_REQUEST_TIMEOUT_MS=10000
HIK_MASTER_POLL_SECONDS=20
HIK_HEARTBEAT_SECONDS=20
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
HIK_ISAPI_TIMEOUT_MS=10000
HIK_CHANNEL_SYNC_SECONDS=300
HIK_STREAM_SETTINGS_CONCURRENCY=4
HIK_SEGMENT_SECONDS=4
HIK_LIVE_WINDOW=8
HIK_ARCHIVE_SEARCH_PAGE_SIZE=64
HIK_ARCHIVE_SEARCH_MAX_PAGES=80
HIK_DEVICE_ARCHIVE_MAX_SECONDS=3600
HIK_DEVICE_ARCHIVE_SESSION_SECONDS=300
HIK_DEVICE_ARCHIVE_SESSION_KEEP_MS=900000
HIK_MEDIA_TOKEN_MAX_SECONDS=3600
HIK_TRANSCODE_H265=true
HIK_RTSP_TRANSPORT=tcp
HIK_FFMPEG_LOGLEVEL=warning
